NODE_ENV=development
PORT=3001

# Postgres connection string (Neon or any Postgres instance)
DATABASE_URL=postgres://user:password@localhost:5432/pulse
# Separate disposable database used only by `npm run test`. Never point this at
# a database with real data.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/pulse_test

# Random long string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Only Google accounts on this Workspace domain may sign in
ALLOWED_GOOGLE_DOMAIN=exvadebio.com

# Where the frontend is served from (used for the post-login redirect and CORS)
FRONTEND_URL=http://localhost:3000

# Anthropic API key for the real interpretation pipeline (noise filter +
# Claude-driven suggestion generation). Get one at https://console.anthropic.com
# (Settings -> API Keys). Optional: the app boots and the test suite passes
# without it -- only `npm run interpret:real -w backend` and real ingestion
# need it set.
ANTHROPIC_API_KEY=
